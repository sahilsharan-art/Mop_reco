# Non-secret settings for the production server (10.0.1.98). Copy to production.env and edit.
# PASSWORDS NEVER GO IN THIS FILE: they are typed once into set_secrets.ps1 and stored encrypted.

# --- the application ---
APP_PORT=8501

# --- the database (PostgreSQL on 10.0.0.205) ---
DB_HOST=10.0.0.205
DB_PORT=5432
DB_NAME=MOPfinanceapp
DB_USER=mopfinance_app

# --- file storage (the NAS share created for this application) ---
NAS_SHARE=\\10.0.0.25\CKAPPLICATIONS_DATA
NAS_FOLDER=\\10.0.0.25\CKAPPLICATIONS_DATA\CKMOPFINANCEAPP_DATA
NAS_USER=ckappuser
