# Non-secret settings for the production server (10.0.1.98). Copy to production.env and edit.
# PASSWORDS NEVER GO IN THIS FILE: the database password is typed once into set_secrets.ps1 and stored encrypted.

# --- the application ---
APP_PORT=8501
# the Windows account the app runs as. It is the SAME local account the other apps on this server use to reach the NAS,
# so the NAS login needs no mapping and no stored NAS password.
RUN_AS_ACCOUNT=.\ckappuser

# --- the database (PostgreSQL on 10.0.0.205) ---
DB_HOST=10.0.0.205
DB_PORT=5432
DB_NAME=MOPfinanceapp
DB_USER=mopfinance_app

# --- file storage (the NAS folder created for this application) ---
NAS_FOLDER=\\10.0.0.25\CKAPPLICATIONS_DATA\CKMOPFINANCEAPP_DATA

# --- the ERP database (PostgreSQL, READ-ONLY; the login is shared with other applications) ---
# The password is typed once into deploy\set_erp_secret.ps1 and stored encrypted - never here.
# ERP_DB_NAME: the DBA named it - data_extraction (NOT postgres or ckpost).
ERP_DB_HOST=10.0.0.82
ERP_DB_PORT=5432
ERP_DB_USER=ckpost
ERP_DB_NAME=data_extraction

# --- where each source comes from: file (default) or erp ---
# erp = read the ERP's gold_mop view (read-only) instead of the Excel / CSV files. Switch a source back to file at any time by editing this
# line and restarting the app; nothing else changes. Needs the ERP_DB_* settings above and the password stored with deploy\set_erp_secret.ps1.
SOURCE_POS=file
SOURCE_PTC=file

# --- the V2 screens (React, beside the dashboard; the dashboard on APP_PORT stays as the rollback) ---
# V2_ENABLE=1 starts them with the application. V2_ORIGIN is EXACTLY the address users type in the browser (scheme, host, port; no trailing
# slash): the API refuses a request whose Origin differs, so the IP address and the host name are two different origins - pick one and use it.
# Use https://... once the infrastructure team puts a certificate in front (the session cookie then becomes Secure automatically).
V2_ENABLE=0
V2_PORT=8091
V2_ORIGIN=http://localhost:8091
